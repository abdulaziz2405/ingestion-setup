# Both auth strings hold the same <USER>:<PASSWORD> pair, and the worker repeats it in
# its own PREFECT_API_AUTH_STRING. SERVER_ one is the credential the server enforces;
# the plain one is what the CLI inside this container authenticates with.
PREFECT_API_AUTH_STRING=<USER>:<PASSWORD>
PREFECT_SERVER_API_AUTH_STRING=<USER>:<PASSWORD>

PREFECT_API_DATABASE_CONNECTION_URL=postgresql+asyncpg://prefect:<PREFECT_DB_PASSWORD>@<TOOL_SERVER>:5432/prefect
PREFECT_SERVER_LOGGING_LEVEL=DEBUG
PREFECT_UI_API_URL=https://<DOMAIN>/prefect/api/
PREFECT_UI_SERVE_BASE=/prefect
PREFECT_UI_URL=https://<DOMAIN>/
TZ=Asia/Tashkent
