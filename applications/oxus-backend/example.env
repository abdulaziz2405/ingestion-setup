# 1. Application configuration:
INTERNAL_API_TOKEN=<INTERNAL TOKEN SHARED BY APPS>
APP_DEBUG=true
APP_ENV=dev
APP_KEY=
APP_NAME=oxus
APP_URL=<BACKEND API URL>
BROADCAST_DRIVER=log
LOG_CHANNEL=stack
LOG_LEVEL=debug

# 2. S3 bucket configuration:
AWS_ENDPOINT=<LINK>

# 3. Redis caching configuration:
CACHE_DRIVER=redis
CACHE_FREQ=30
REDIS_HOST=<DB_SERVER>
REDIS_PASSWORD=
REDIS_PORT=6379

# 4. PostgreSQL database connection:
DB_CONNECTION=pgsql
DB_HOST=<DB_SERVER>
DB_PORT=5432
DB_DATABASE=amudario
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer

# 5. InfluxDB database connection:
INFLUX_BUCKET=<INFLUX BUCKET NAME>
INFLUX_ORG=<INFLUX ORG NAME>
INFLUX_TOKEN=<INFLUX GENERATED TOKEN>
INFLUX_URL=http://<INGESTION_SERVER>:8086

# 6. Mosquitto ingestion parameters:
MQTT_HOST=<INGESTION_SERVER>
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
QUEUE_CONNECTION=sync

# 7. SMS sending parameters:
ESKIZ_LOGIN=
ESKIZ_PASSWORD=

# 8. Mailing parameters:
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME=${APP_NAME}
MAIL_MAILER=log
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# 9. Other: 
METEOBLUE_API_KEY=4VhZtmGCfv0xE8zH
SESSION_DRIVER=file
SESSION_LIFETIME=120
